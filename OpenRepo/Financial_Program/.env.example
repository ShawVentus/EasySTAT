# ========================================
# Financial_Program 环境变量配置模板
# ========================================
# 使用方法：
# 1. 复制此文件到 backend/.env
# 2. 根据实际情况修改配置值
# ========================================

# ========== LLM 配置（大语言模型）==========
# 通义千问配置示例
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=qwen-plus

# Deepseek 配置示例（如需使用，取消注释并替换上方配置）
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=sk-your-deepseek-key
# LLM_MODEL=deepseek-chat

# OpenAI 配置示例
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your-openai-key
# LLM_MODEL=gpt-4

# ========== MySQL 数据库配置 ==========
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=financial_web_crawler

# ========== Redis 缓存配置 ==========
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ========== 存储配置 ==========
# 存储类型：local（本地文件夹）或 minio（对象存储）
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=./data/reports

# MinIO 配置（如需使用，将 STORAGE_TYPE 改为 minio 并取消以下注释）
# MINIO_ENDPOINT=localhost:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=data-financial-agent
# MINIO_SECURE=False

# ========== 兼容旧配置（向后兼容）==========
# 如果代码中仍有 DEEPSEEK_API_KEY 的引用，自动映射到新变量
DEEPSEEK_API_KEY=${LLM_API_KEY}
DEEPSEEK_BASE_URL=${LLM_BASE_URL}
