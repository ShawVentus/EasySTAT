# EasySTAT WebUI 后端环境变量配置

# 是否开启调试模式
DEBUG=true

# EasySTAT 项目路径 (绝对路径)
EASYSTAT_PROJECT_PATH=/Users/mac/dev/personal/br_competition/EasySTAT

# 数据总线存储路径
DATA_BUS_PATH=/Users/mac/dev/personal/br_competition/EasySTAT/data/shared

# 结果存储路径
RESULT_DIR=/Users/mac/dev/personal/br_competition/EasySTAT/result

# 日志存储路径
LOG_DIR=/Users/mac/dev/personal/br_competition/EasySTAT/logs
