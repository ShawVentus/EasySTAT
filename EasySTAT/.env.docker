# ==========================================
# EasySTAT Docker 容器环境变量配置
# ==========================================
# 说明：此文件用于 Docker 部署，Dockerfile 会将其复制为 .env
# 所有路径均为容器内路径（以 /app 开头）

# LLM 配置
OPENAI_API_KEY=4c97924ea86e4b40b9cf091dcfd20e44
OPENAI_API_BASE=https://openapi.dp.tech/openapi/v1
OPENAI_MODEL_NAME=qwen-plus

# 路径配置（容器内路径）
FINANCIAL_CREW_SRC_PATH=/app/EasySTAT/src
TA_ANA_PATH=/app/EasySTAT/src
ARCH_MODEL_PATH=/app/EasySTAT/src
FINANCIAL_PROGRAM_BACKEND_PATH=/app/crawler

# 性能配置
MAX_MACRO_CONCURRENT=3
MAX_STOCK_CONCURRENT=5
REPORT_OUTPUT_DIR=/app/EasySTAT/result

# 缓存配置
AKSHARE_CACHE_PATH=/app/EasySTAT/data/cache
AKSHARE_REQUEST_TIMEOUT=30

# 数据总线配置
DATA_BUS_PATH=/app/EasySTAT/data/shared
